*.pth

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
venv_extract/
ENV/
env/

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ── IDE & OS files ───────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log

# ── Intentionally NOT ignored ────────────────────────────────────────────────
# *.glb        — hand.glb is the 3-D avatar asset required to run the demo (~1 MB)
# *.html       — text-to-sign avatar UI (output of the bidirectional pipeline)
# *.json       — label maps (label_map*.json, cm.json) — small & needed for inference
# *.png        — training result charts (accuracy_loss, confusion_matrix, training_results)
